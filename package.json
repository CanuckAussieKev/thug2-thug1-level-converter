{
  "name": "thug2-thug1-level-converter",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "THUG2 THUG1 Level Converter: Tony Hawk's Underground (PC) levels converted to Tony Hawk's Underground 2's formats.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CanuckAussieKev/thug2-thug1-level-converter.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./thug1_levels/driving.ts": {
      "types": "./thug1_levels/driving.ts",
      "default": "./thug1_levels/driving.js"
    },
    "./package.json": "./package.json"
  },
  "commands": [
    "thug1_campaign/script_gap.ts",
    "thug1_campaign/thug1_sizes.ts",
    "thug1_levels/migrate_layouts.ts",
    "thug1_levels/thug1_levels.ts",
    "thug1_levels/thugpro_compare.ts"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#96f3421f8bd4147ddda43c95af64c7201ba6c383",
    "thug2-thugpro-compat": "git+https://git@github.com/CanuckAussieKev/thug2-thugpro-compat.git#39651fa398dec289c96832454b4f97f30fa0c1df"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
